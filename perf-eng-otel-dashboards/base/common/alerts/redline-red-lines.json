    {
      "orgId": 1,
      "name": "RedLine red lines",
      "folder": "demo-perf",
      "interval": "5m",
      "rules": [
        {
          "uid": "rl-9e5137ad9bda",
          "title": "RedLine red line — demo-api/api-benchmark GET /api/config p95 > 1000ms",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 1800,
                "to": 0
              },
              "datasourceUid": "P2EDC53E3FEAC6ED1",
              "model": {
                "expr": "histogram_quantile(0.95, sum by (le) (increase(k6_demo_api_config_health_milliseconds_bucket{product=\"demo-api\", test_file=\"api-benchmark\", environment=\"staging\"}[30m])))",
                "instant": true,
                "refId": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "type": "threshold",
                "refId": "C",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1000
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "OK",
          "labels": {
            "source": "redline",
            "team": "demo-api",
            "profile": "api-benchmark"
          },
          "annotations": {
            "summary": "demo-api/api-benchmark — GET /api/config p95 crossed its red line (1000ms). Baseline: baselines/demo-api.api-benchmark.json."
          }
        },
